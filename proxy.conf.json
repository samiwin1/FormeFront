    "changeOrigin": true,
    "logLevel": "debug",
    "pathRewrite": { "^/user-api": "/api" }
  },
  "/formation-api": {
    "target": "http://localhost:8082",
    "secure": false,
    "changeOrigin": true,
    "logLevel": "debug",
    "pathRewrite": { "^/formation-api": "/api" }
  },
  "/events-api": {
    "target": "http://localhost:8082",
    "secure": false,
